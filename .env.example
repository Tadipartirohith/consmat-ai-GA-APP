# ---- Consmat AI platform — infra knobs (safe defaults for local) ----
# Host ports (change if any collide with something already running):
BACKEND_PORT=3000
BUYER_PORT=8080
VENDOR_PORT=8081
ADMIN_PORT=8082
DISPATCH_PORT=8083

# Backend JWT secret (change in production)
JWT_SECRET=change-me-in-prod

# --- AI chat engine ---
# stub  = deterministic understanding, no key, no cost (default; works fully offline)
# openai or anthropic = use a real LLM for understanding messy requests. Prices
#   always still come from the backend, never the model.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=
# (e.g. AI_PROVIDER=openai, AI_API_KEY=sk-..., AI_MODEL=gpt-4o-mini)

# NOTE: all *business* data (vendors, materials, pricing, demo accounts, seeded
# orders) lives in backend/config.yaml — edit that file, then restart backend.
# The frontends reach the API through nginx (/api -> backend), so there is no
# API URL to configure here.
