# ---- Consmat AI platform — infra knobs (safe defaults for local) ----
# Host ports (change if any collide with something already running):
BACKEND_PORT=3000
BUYER_PORT=8080
VENDOR_PORT=8081
ADMIN_PORT=8082
DISPATCH_PORT=8083

# Backend JWT secret (change in production)
JWT_SECRET=change-me-in-prod

# --- AI chat engine ---
# stub  = deterministic understanding, no key, no cost (default; works fully offline)
# openai or anthropic = use a real LLM for understanding messy requests. Prices
#   always still come from the backend, never the model.
AI_PROVIDER=stub
AI_API_KEY=
AI_MODEL=
# (e.g. AI_PROVIDER=openai, AI_API_KEY=sk-..., AI_MODEL=gpt-4o-mini)

# --- Payment gateway (SECRETS go here, switches go in config.yaml -> payments) ---
# Leave blank for the local stub. When you set provider=razorpay/stripe/... in
# config.yaml and enabled=true, fill the matching secrets here and wire the
# adapter (see README "Configuration for the ops team -> Payment gateway").
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Logistics (real road distances, optional) ---
# Set config.yaml -> logistics_engine.provider: osrm and point this at your OSRM.
OSRM_URL=

# --- Notifications (WhatsApp / SMS, optional) ---
NOTIFY_API_KEY=

# --- Database (only when config.yaml -> persistence.mode: postgres) ---
DATABASE_URL=

# NOTE: all *business* data (vendors, materials, pricing, demo accounts, seeded
# orders) lives in backend/config.yaml. Edit that file, then restart the backend.
# Locally the frontends reach the API through nginx (/api -> backend), so there
# is no API URL to set for local runs; for a real deployment behind domains, see
# the README "Configuration for the ops team".
